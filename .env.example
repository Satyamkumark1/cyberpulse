# Local defaults work as-is with `docker compose up`.
# architecture/deployment-architecture.md §5 — the only committed env file.

# Database
DATABASE_URL=postgres://cyberpulse:cyberpulse@localhost:5432/cyberpulse

# ML service
ML_SERVICE_URL=http://localhost:8000

# Map
NEXT_PUBLIC_MAP_TILE_URL=https://demotiles.maplibre.org/style.json

# Application
NEXT_PUBLIC_APP_NAME=CyberPulse AI
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ANALYTICS_ENABLED=true
LOG_LEVEL=info
APP_VERSION=0.1.0

# Data
DATA_SEED=26184

# ML service only
MODEL_DIR=./models
