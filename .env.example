# Environment variables for deploying the web app (Vercel → Settings → Environment Variables).
# The only committed env file. Never put a real password here.

# Neon pooled string: Neon console → cyberpulse → Connect → Connection pooling on → copy
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/cyberpulse?sslmode=require

ML_SERVICE_URL=https://cyberpulse-ml-372f.onrender.com
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty
LOCATION_SERVICE_URL=https://photon.komoot.io
# Optional free local Redis/Valkey cache. Leave blank to use in-memory fallbacks.
REDIS_URL=redis://localhost:6379
# Server-only credentials for the optional AI voice assistant.
# GROQ_API_KEY=gsk_...
# Optional second key, used when the first is rate-limited or rejected (DEC-016).
# GROQ_API_KEY_FALLBACK=gsk_...
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
NEXT_PUBLIC_DEMO_MODE=true
# Unlocks the ADMIN prototype role: demo reset, settings, simulation (ADR-023).
# At least 12 characters; generate one per environment: openssl rand -base64 18
ADMIN_ACCESS_CODE=<generate-a-long-random-code>
