# Local defaults work as-is with `docker compose up`.
# architecture/deployment-architecture.md §5 — the only committed env file.
# Never put a real password here. Production values go in each host's dashboard.

# Database
# Production (Vercel): the Neon *pooled* string — host contains "-pooler".
#   Migrate/seed/evaluate from a laptop with the *direct* (non-pooled) string.
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/cyberpulse?sslmode=require
DATABASE_URL=postgres://cyberpulse:cyberpulse@localhost:5432/cyberpulse

# ML service
# Production (Vercel): the Render URL, https, no trailing slash, e.g.
#   https://cyberpulse-ml-372f.onrender.com
ML_SERVICE_URL=http://localhost:8000

# Map — same value in every environment.
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty
# Geographic search/reverse lookup; replace with your Photon instance for higher usage.
LOCATION_SERVICE_URL=https://photon.komoot.io

# Application — defaults are fine in production; values with spaces need quotes
# when this file is sourced by a shell.
NEXT_PUBLIC_APP_NAME="CyberPulse AI"
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ANALYTICS_ENABLED=true
LOG_LEVEL=info
APP_VERSION=0.1.0

# Data — same seed everywhere (RULE-deployment.md).
DATA_SEED=26184

# ML service only. render.yaml / docker/Dockerfile.ml set these for production
# (MODEL_DIR=/app/models); nothing to add in the Render dashboard.
MODEL_DIR=./models
