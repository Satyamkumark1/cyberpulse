# architecture/deployment-architecture.md §4. Next.js standalone output,
# non-root, Node 20 slim. Used for local Compose parity and any non-Vercel
# host; Vercel builds from source.
FROM node:20-slim AS base
RUN corepack enable

FROM base AS deps
WORKDIR /build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /build
COPY --from=deps /build /build
COPY . .
RUN pnpm --filter web run build

FROM base AS runtime
RUN useradd --create-home --uid 10001 appuser
WORKDIR /app
COPY --from=build /build/apps/web/.next/standalone ./
COPY --from=build /build/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /build/apps/web/public ./apps/web/public
ENV PORT=3000 NODE_ENV=production
USER appuser
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
