{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cyberpulse.ai/schemas/prediction.schema.json",
  "title": "PredictionResponse",
  "description": "POST /api/predict 201 response — the persisted row (architecture/api-design.md API-010). Every value here comes from the model; none may be hard-coded in application code (TC-INT-010, TC-INT-012).",
  "type": "object",
  "properties": {
    "predictionRef": { "type": "string", "pattern": "^PRD-[0-9]{4,}$" },
    "complaintId": { "type": "string", "pattern": "^C-[0-9]{5}$" },
    "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "predictedLocation": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "h3Index": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "district": { "type": "string" },
        "state": { "type": "string" }
      },
      "required": ["name", "h3Index", "lat", "lon", "district", "state"],
      "additionalProperties": false
    },
    "expectedWindow": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "fallback": { "type": "boolean" }
      },
      "required": ["start", "end", "confidence", "fallback"],
      "additionalProperties": false
    },
    "likelyAtms": { "type": "integer", "minimum": 0 },
    "estimatedExposurePaise": { "type": "integer", "minimum": 0 },
    "rankedHotspots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "h3Index": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "likelyAtms": { "type": "integer", "minimum": 0 }
        },
        "required": ["rank", "name", "h3Index", "lat", "lon", "score", "likelyAtms"],
        "additionalProperties": false
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "Transaction Velocity",
              "Historical Hotspot",
              "Linked Account Pattern",
              "ATM Proximity",
              "Time Pattern",
              "Amount / Frequency",
              "Account Age",
              "Withdrawal History",
              "Other factors"
            ]
          },
          "contribution": { "type": "number", "minimum": -100, "maximum": 100 },
          "direction": { "type": "string", "enum": ["INCREASES", "REDUCES"] }
        },
        "required": ["name", "contribution", "direction"],
        "additionalProperties": false
      }
    },
    "explanationAvailable": { "type": "boolean" },
    "clusteringFallback": { "type": "boolean" },
    "modelVersion": { "type": "string" },
    "featureSchemaVersion": { "type": "string" },
    "inferenceMs": { "type": ["integer", "null"], "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "pipelineStages": {
      "type": ["array", "null"],
      "description": "Per-stage inference timings, present only on a freshly-computed prediction (never on one re-served from `predictions`) — what /demo's step 3 progress reads (architecture/api-design.md ML-001, AC-P7-04). Not persisted.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 }
        },
        "required": ["name", "durationMs"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "predictionRef", "complaintId", "riskScore", "riskLevel", "confidence",
    "predictedLocation", "expectedWindow", "likelyAtms", "estimatedExposurePaise",
    "rankedHotspots", "factors", "explanationAvailable", "clusteringFallback",
    "modelVersion", "featureSchemaVersion", "createdAt"
  ],
  "additionalProperties": false
}
